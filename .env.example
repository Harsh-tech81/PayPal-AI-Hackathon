# ==========================================
# PayShield AI - Master Environment Variables Template
# ==========================================

# ------------------------------------------
# Environment & Application Settings
# ------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------
# Service Ports (Fastify Microservices + Next.js Web App)
# ------------------------------------------
USER_SERVICE_PORT=8001
USER_SERVICE_URL=http://localhost:8001

TRANSACTION_SERVICE_PORT=8002
TRANSACTION_SERVICE_URL=http://localhost:8002

VERIFICATION_AGENT_PORT=8003
VERIFICATION_AGENT_URL=http://localhost:8003

RISK_ENGINE_PORT=8004
RISK_ENGINE_URL=http://localhost:8004

ALERT_SERVICE_PORT=8005
ALERT_SERVICE_URL=http://localhost:8005

ESCALATION_SERVICE_PORT=8006
ESCALATION_SERVICE_URL=http://localhost:8006

WEB_APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# AI & LLM Configuration (Google Gemini + LangGraph)
# ------------------------------------------
# Google Gemini 1.5 Flash API Key for riddle challenge generation & verification
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# LangGraph Agent Settings
LANGGRAPH_TIMEOUT_SECONDS=10
LANGGRAPH_CHALLENGE_THRESHOLD=0.85
LANGGRAPH_BORDERLINE_MIN=0.60
LANGGRAPH_BORDERLINE_MAX=0.84

# ------------------------------------------
# Databases (PostgreSQL / Supabase with pgvector + MongoDB)
# ------------------------------------------
# Supabase Transaction Pooler URL (Port 6543 - for runtime application queries with PgBouncer)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Port 5432 - required for Prisma CLI migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client API & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MongoDB (Encrypted Intent Form Memory Anchors Vault)
MONGODB_URI=mongodb://localhost:27017/payshield_intent_vault

# Redis (ioredis - 10s countdown interrupt timer, session tokens, rate limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Security & Cryptography (DEV 1)
# ------------------------------------------
# AES-256-GCM Master Key (32 bytes hex encoded for Node Web Crypto)
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Argon2id Hashing Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# JWT Authentication (RS256 Private & Public Keys)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# Alert Channels (DEV 5)
# ------------------------------------------
# Twilio SMS Dispatcher
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199

# Nodemailer Gmail SMTP Dispatcher (Direct Primary Inbox Delivery)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Firebase Admin SDK (Mobile & Web Push Alerts)
FIREBASE_PROJECT_ID=payshield-ai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@payshield-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------
# Escalation & Incident Response (DEV 5)
# ------------------------------------------
DEFAULT_FREEZE_DURATION_HOURS=1
BANK_ROUTING_NUMBER=121000358
BANK_API_GATEWAY_URL=https://api.partnerbank.com/v1/fraud-reporting
BANK_API_KEY=your_bank_api_key_here
EDGE_WAF_API_URL=https://api.cloudflare.com/client/v4/zones
EDGE_WAF_API_TOKEN=your_waf_api_token_here
