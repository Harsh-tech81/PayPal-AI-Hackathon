// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  salt         String
  isActive     Boolean   @default(true) @map("is_active")
  isFrozen     Boolean   @default(false) @map("is_frozen")
  frozenUntil  DateTime? @map("frozen_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  devices      Device[]
  transactions Transaction[]

  @@map("users")
}

model Device {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceFingerprint String   @map("device_fingerprint")
  deviceName        String   @map("device_name")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  isTrusted         Boolean  @default(true) @map("is_trusted")
  lastSeen          DateTime @default(now()) @map("last_seen")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceFingerprint])
  @@map("devices")
}

model Transaction {
  id                String   @id @default(uuid())
  senderId          String   @map("sender_id")
  recipientEmail    String   @map("recipient_email")
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  status            String   @default("PENDING")
  riskScore         Float    @default(0.0) @map("risk_score")
  ipAddress         String?  @map("ip_address")
  deviceFingerprint String?  @map("device_fingerprint")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@map("transactions")
}

model FraudIncident {
  id              String    @id @default(uuid())
  transactionId   String    @map("transaction_id")
  userId          String    @map("user_id")
  riskScore       Float     @map("risk_score")
  triggerRules    String?   @map("trigger_rules")
  status          String    @default("INVESTIGATING")
  reportedToBank  Boolean   @default(false) @map("reported_to_bank")
  bankReferenceId String?   @map("bank_reference_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  @@index([transactionId])
  @@index([userId])
  @@map("fraud_incidents")
}

model BlockedIp {
  id        String   @id @default(uuid())
  ipAddress String   @unique @map("ip_address")
  reason    String
  blockedAt DateTime @default(now()) @map("blocked_at")
  expiresAt DateTime @map("expires_at")

  @@map("blocked_ips")
}
