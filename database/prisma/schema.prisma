generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  phone               String?               @unique
  fullName            String
  passwordHash        String
  kycStatus           String                @default("pending")
  riskTier            String                @default("standard")
  isFrozen            Boolean               @default(false)
  frozenUntil         DateTime?
  frozenReason        String?
  intentFormCompleted Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  devices             Device[]
  sentTransactions    Transaction[]         @relation("SentTxns")
  receivedTransactions Transaction[]        @relation("ReceivedTxns")
  fraudIncidents      FraudIncident[]
  alertLogs           AlertLog[]

  @@map("users")
}

model Device {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName        String
  deviceFingerprint String   @unique
  osType            String   @default("unknown")
  isTrusted         Boolean  @default(false)
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@map("devices")
}

model Transaction {
  id                 String                @id @default(uuid())
  senderId           String
  receiverId         String?
  recipientEmail     String?
  sender             User                  @relation("SentTxns", fields: [senderId], references: [id])
  receiver           User?                 @relation("ReceivedTxns", fields: [receiverId], references: [id])
  amount             Decimal               @db.Decimal(15, 2)
  currency           String                @default("USD")
  description        String?
  status             String                @default("pending") // pending, verifying, approved, rejected, frozen, voided
  riskScore          Float?
  verificationMethod String?               // auto, genai_challenge
  ipAddress          String?
  createdAt          DateTime              @default(now())
  attempts           VerificationAttempt[]
  incidents          FraudIncident[]

  @@map("transactions")
}

model VerificationAttempt {
  id              String      @id @default(uuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  questionAsked   String
  answerSubmitted String?
  isCorrect       Boolean
  confidence      Float
  responseTimeMs  Int
  createdAt       DateTime    @default(now())

  @@map("verification_attempts")
}

model FraudIncident {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  incidentType    String       // failed_verification, timeout_lockout
  severity        String       @default("high")
  attackerIp      String?
  forensicData    Json?
  status          String       @default("open") // open, investigated, resolved
  reportedToBank  Boolean      @default(false)
  bankReferenceId String?
  createdAt       DateTime     @default(now())

  @@map("fraud_incidents")
}

model AlertLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String   // sms, email, push
  message   String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("alert_logs")
}

model BlockedIp {
  id        String    @id @default(uuid())
  ipAddress String    @unique
  reason    String
  blockedAt DateTime  @default(now())
  expiresAt DateTime?

  @@map("blocked_ips")
}
